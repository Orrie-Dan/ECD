# =============================================================================
# ECD Frontend environment
# =============================================================================
# Development default is mock (demo UI without Nest).
# Production deployments MUST set:
#   VITE_API_MODE=live
#   VITE_API_BASE_URL=<https://your-api-origin>   # never localhost in production
# =============================================================================

# mock (default) — existing mock data / UI login continue to work
# live — Axios client talks to Nest; use generated hooks from src/api
VITE_API_MODE=mock

# NestJS API origin (no trailing slash). Used only when VITE_API_MODE=live.
# Local development example:
VITE_API_BASE_URL=http://localhost:3000

# ArcGIS ECD Mapping System (optional — defaults to national portal webmap)
# The SPA iframes /ecd/dashboards/ecd-mapping/index.html (same-origin) — not the Portal URL.
# VITE_ARCGIS_PORTAL_URL=https://infrastructure.space.gov.rw/portal
# VITE_ARCGIS_WEBMAP_ID=2b7f6d9cd1ac43bf993f811e7844014d
